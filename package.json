{
  "name": "toons-et-bulles",
  "productName": "Toons & Bulles",
  "version": "1.7.0",
  "description": "Dessins animés, BD et livres jeunesse pour toute la famille : catalogue, collection, listes, sagas, profils enfants, bandes-annonces, musique et quiz.",
  "author": {
    "name": "Didier Beltran"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "homepage": "https://github.com/didail84/toons-et-bulles",
  "repository": {
    "type": "git",
    "url": "https://github.com/didail84/toons-et-bulles.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "43.7.11",
    "electron-builder": "26.17.0"
  },
  "desktop": {
    "host": "toons-et-bulles",
    "repo": "didail84/toons-et-bulles",
    "background": "#0F1426",
    "api": "toonsNet"
  },
  "build": {
    "appId": "io.github.didail84.toonsetbulles",
    "productName": "Toons & Bulles",
    "artifactName": "ToonsEtBulles-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": "-",
      "minimumSystemVersion": "12.0",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Toons & Bulles ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toons & Bulles",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
